# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Por padrão usa SQLite (deixe comentado para SQLite)
# Para usar PostgreSQL, descomente as linhas abaixo e configure

# SQLite (Padrão - não precisa configurar nada)
# DATABASE_ENGINE=django.db.backends.sqlite3

# PostgreSQL (Descomente e configure as variáveis abaixo)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=travel_system
# DATABASE_USER=travel_admin
# DATABASE_PASSWORD=sua_senha_forte_aqui
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Language and Timezone
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo
